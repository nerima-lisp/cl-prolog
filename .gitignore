# nerima-lisp standard .gitignore
# Copy to <repo>/.gitignore and append repository-specific entries below the
# marked section. Everything above the marker must stay identical across repos
# so that "is this artifact ignored?" has the same answer everywhere.

# --- Common Lisp build output ---
*.fasl
*.fas
*.lib
*.dfsl
*.ufsl
*.fsl

# --- Nix ---
/result
/result-*
/.direnv/

# --- Test and coverage output ---
/coverage/
/coverage-report/
/*-coverage-report/
*.coverage
coverage.dat
/__snapshots__/
/*-snapshots/

# --- Local caches and scratch space ---
/.cache/
/.deps/
/tmp/
/.worktrees/
/.paredit.cleanup/

# --- Editor and OS noise ---
.DS_Store
*~
\#*\#
.\#*

# --- Repository-specific entries below this line ---

# Fasl extensions for implementations outside the template's list. Kept even
# though CI is SBCL-only: a contributor's CCL or CMUCL scratch build should not
# show up as untracked noise.
*.dx64fsl
*.lx64fsl
*.x86f
*.cache

# ASDF source-registry index, generated by tooling in the working tree.
system-index.txt

# MkDocs local build output. docs/mkdocs.yml sets site_dir: ../site, so a bare
# `mkdocs build -f docs/mkdocs.yml` writes here rather than under docs/.
/site/

.worktrees/
